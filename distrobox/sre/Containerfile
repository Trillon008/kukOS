FROM registry.fedoraproject.org/fedora-toolbox:45

COPY / /ctx

## Install repo and packages
RUN dnf config-manager addrepo --from-repofile /ctx/repos/github.repo \
  && dnf config-manager addrepo --from-repofile /ctx/repos/hashicorp.repo

RUN dnf update -y  && \
  /bin/bash /ctx/packages.sh

## Cleanup
RUN rm -rf /ctx && \
  dnf autoremove -y && dnf clean all
